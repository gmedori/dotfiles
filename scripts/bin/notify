#!/usr/bin/env ruby

require 'optparse'

options = {}

parser = OptionParser.new do |opts|
  opts.banner = "Usage: notify message [options]"

  opts.on("-t", "--title=TITLE", "Title of notification banner") do |t|
    options[:title] = t
  end

  opts.on("-s", "--sound=SOUND", "Sound of notification banner") do |s|
    options[:sound] = s
  end

  opts.on("--subtitle=SUBTITLE", "Subtitle of notification banner") do |s|
    options[:subtitle] = s
  end

end

parser.parse!

if ARGV.empty?
  puts parser.help
  exit 1
end

message = ARGV.join(" ")

command = "display notification \"#{message}\""
command = "#{command} with title \"#{options[:title]}\"" unless options[:title].nil?
command = "#{command} with subtitle \"#{options[:subtitle]}\"" unless options[:subtitle].nil?

if options[:sound]
  command = "#{command} sound name \"#{options[:sound]}\""
else
  command = "#{command} sound name \"purr\""
end

command = "/usr/bin/osascript -e '#{command}'"

exec(command)
