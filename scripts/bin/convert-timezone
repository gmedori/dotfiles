#!/usr/bin/env perl

use strict;
use warnings;
use autodie;

use feature 'say';

use DateTime;
use DateTime::TimeZone;

my $input = shift @ARGV;
$input =~ /(\d+):(\d+)/;
my ($hour, $minute) = ($1, $2);
my $dt = DateTime->now();

my $tz = DateTime::TimeZone->new( name => "local" );
$dt->set_time_zone($tz);
$dt->set(hour=>$hour, minute=>$minute);
$dt->set_time_zone('America/Los_Angeles');

($hour, $minute) = ($dt->hour, $dt->minute);
if ($hour < 10) { $hour = "0$hour"; }
if ($minute < 10) { $minute = "0$minute"; }

say "$hour:$minute";
